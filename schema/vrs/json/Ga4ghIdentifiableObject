{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/vrs/2.2.0-ballot.2026-09.1/json/Ga4ghIdentifiableObject",
   "title": "Ga4ghIdentifiableObject",
   "type": "object",
   "maturity": "trial use",
   "abstract": true,
   "description": "An object for which a GA4GH computed identifier can be created.",
   "ga4gh": {
      "inherent": [
         "type"
      ]
   },
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the Entity in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "type": {
         "type": "string",
         "description": "The name of the class that is instantiated by a data object representing the Entity."
      },
      "name": {
         "type": "string",
         "description": "A primary name for the entity."
      },
      "description": {
         "type": "string",
         "description": "A free-text description of the Entity."
      },
      "aliases": {
         "type": "array",
         "ordered": false,
         "items": {
            "type": "string"
         },
         "description": "Alternative name(s) for the Entity."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      },
      "digest": {
         "description": "A sha512t24u digest created using the VRS Computed Identifier algorithm.",
         "type": "string",
         "pattern": "^[0-9A-Za-z_\\-]{32}$"
      }
   },
   "required": [
      "type"
   ]
}
