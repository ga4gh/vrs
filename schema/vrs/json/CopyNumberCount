               "$ref": "/ga4gh/schema/vrs/2.2.0-ballot.2026-09.1/json/SequenceLocation"
            }
         ],
         "description": "The location of the subject of the copy count."
      },
      "copies": {
         "oneOf": [
            {
               "type": "integer"
            },
            {
               "$ref": "/ga4gh/schema/vrs/2.2.0-ballot.2026-09.1/json/Range"
